{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "settings-emulator",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_USE_FIREBASE_EMULATORS=true",
        "VITE_FIREBASE_PROJECT_ID=demo-debate",
        "VITE_FIREBASE_API_KEY=demo-key",
        "VITE_FIREBASE_AUTH_DOMAIN=demo-debate.firebaseapp.com",
        "VITE_FIREBASE_STORAGE_BUCKET=demo-debate.appspot.com",
        "VITE_FIREBASE_APP_ID=1:1:web:demo",
        "npx",
        "vite",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    }
  ]
}
