rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsExistingResource(fieldName) {
      return isSignedIn() && resource.data[fieldName] == request.auth.uid;
    }

    function hasValidSpeechVisibility() {
      return request.resource.data.visibility in ["private", "public"];
    }

    function canReadSpeech(speechId) {
      return isSignedIn()
        && (
          resource.data.visibility == "public"
          || resource.data.creatorId == request.auth.uid
          || exists(/databases/$(database)/documents/speechShares/$(speechId)/recipients/$(request.auth.uid))
        );
    }

    // The AI speech summary is produced server-side by a Cloud Function, so
    // clients must never be able to write or edit it.
    function keepsServerManagedSpeechSummary() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "aiSummary",
        "summary",
        "summaryStatus",
        "summaryModel",
        "summaryPromptVersion",
        "summaryTranscriptRef",
        "summaryResponseId",
        "summaryGeneratedAt",
        "summaryError",
        "summaryProcessingEventId",
        "transcriptStatus"
      ]);
    }

    function isCommentCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "likeCount",
          "dislikeCount",
          "replyCount",
          "updatedAt"
        ])
        && stepsAtMostOne("likeCount")
        && stepsAtMostOne("dislikeCount")
        && stepsAtMostOne("replyCount");
    }

    function isOwnCommentEdit() {
      return ownsExistingResource("authorId")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "content",
          "editedAt",
          "updatedAt"
        ]);
    }

    // A vote belongs to the user named in its ID, and only they can change it.
    function isOwnReactionWrite(reactionId, parentField) {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && reactionId == request.resource.data[parentField] + "-" + request.auth.uid
        && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Tallies are maintained by clients, so a single write can only move each
    // one by a step. Fields may be missing on older documents.
    function stepsAtMostOne(field) {
      let previous = resource.data.get(field, 0);
      let next = request.resource.data.get(field, 0);
      return next is int
        && next >= 0
        && next >= previous - 1
        && next <= previous + 1;
    }

    function incrementsByOne(field) {
      return request.resource.data[field] is int
        && request.resource.data[field] == resource.data.get(field, 0) + 1;
    }

    function hasValidDisplayName() {
      return request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30;
    }

    function keepsExistingDisplayName() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "displayName"
      ]);
    }

    // Profile photos are moderated and written by the uploadProfilePhoto
    // callable, so clients can't point their profile at an arbitrary image or
    // at another user's stored file.
    function keepsServerManagedAvatar() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "avatarUrl",
        "avatarStoragePath"
      ]);
    }

    // User documents are readable by every member, so an email address must
    // never be stored on one. Old values may stay or be removed, not changed.
    function addsNoEmail() {
      return !("email" in request.resource.data)
        || ("email" in resource.data && request.resource.data.email == resource.data.email);
    }

    function keepsServerManagedUsername() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "username",
        "usernameUpdatedAt"
      ]);
    }

    // Defaults to "everyone" when the recipient has no profile document or has
    // never saved a messaging preference. Reading `.data` off a missing
    // document instead throws, which denied every new conversation.
    function messagingPermissionFor(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      return (
          userDoc == null
          || !("preferences" in userDoc.data)
          || !("messaging" in userDoc.data.preferences)
          || !("whoCanMessage" in userDoc.data.preferences.messaging)
        )
        ? "everyone"
        : userDoc.data.preferences.messaging.whoCanMessage;
    }

    function recipientAllowsMessage(recipientId, senderId) {
      let permission = messagingPermissionFor(recipientId);
      return !isBlockedBetween(recipientId, senderId)
        && (permission == "everyone"
        || (
          permission == "following"
          && exists(/databases/$(database)/documents/follows/$(recipientId + "-" + senderId))
        ));
    }

    function isBlockedBetween(firstId, secondId) {
      return exists(/databases/$(database)/documents/userBlocks/$(firstId + "-" + secondId))
        || exists(/databases/$(database)/documents/userBlocks/$(secondId + "-" + firstId));
    }

    function hasJoinedChannel(channelId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/channelMemberships/$(channelId + "-" + request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && hasValidDisplayName()
        && !("username" in request.resource.data)
        && !("usernameUpdatedAt" in request.resource.data)
        && !("email" in request.resource.data)
        && !("avatarStoragePath" in request.resource.data)
        && (!("avatarUrl" in request.resource.data)
          || request.resource.data.avatarUrl.matches("https://[a-z0-9]+[.]googleusercontent[.]com/.*"));
      allow update: if isOwner(userId)
        && keepsExistingDisplayName()
        && keepsServerManagedUsername()
        && keepsServerManagedAvatar()
        && addsNoEmail();
    }

    // Username reservations are maintained atomically by the updateUsername
    // callable. Clients must not create, move, or delete reservations.
    match /usernames/{username} {
      allow read, write: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        // Messaging trusts this ID to mean "the first user follows the second".
        && followId == request.auth.uid + "-" + request.resource.data.followingId
        && !isBlockedBetween(request.resource.data.followerId, request.resource.data.followingId);
      allow delete: if ownsExistingResource("followerId");
    }

    match /userBlocks/{blockId} {
      allow read: if isSignedIn()
        && (resource == null
          || resource.data.blockerId == request.auth.uid
          || resource.data.blockedId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + "-" + request.resource.data.blockedId;
      allow delete: if ownsExistingResource("blockerId");
    }

    match /userReports/{reporterId}/reports/{reportedId} {
      allow get: if isOwner(reporterId);
      allow list: if false;
      allow create: if isOwner(reporterId)
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedId == reportedId
        && reportedId != request.auth.uid
        && request.resource.data.reason in ["Harassment", "Inappropriate content", "Spam", "Impersonation", "Other"]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == "open";
    }

    // Tournament history is opt-in. It stays private to its owner unless they
    // have turned on showTabroomHistory.
    function canReadTabroomData() {
      return isSignedIn()
        && (resource.data.userId == request.auth.uid
          || get(/databases/$(database)/documents/users/$(resource.data.userId)).data.get("showTabroomHistory", false) == true);
    }

    match /tabroomLinks/{linkId} {
      allow read: if canReadTabroomData();
      allow create, update, delete: if false;
    }

    match /tabroomImports/{importId} {
      allow read: if canReadTabroomData();
      allow create, update, delete: if false;
    }

    // Authentication cookies are encrypted and managed exclusively by Admin SDK
    // callables. They must never be exposed through the client Firestore SDK.
    match /tabroomSessions/{userId} {
      allow read, write: if false;
    }

    // Posts and comments carry a copy of their channel's visibility so that
    // lists can be queried and checked without one lookup per document.
    function canReadChannelContent() {
      return resource.data.channelVisibility == "public"
        || (resource.data.channelVisibility == "private"
          && hasJoinedChannel(resource.data.channelId));
    }

    match /posts/{postId} {
      allow read: if canReadChannelContent();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && (
          (
            (!('channelId' in request.resource.data)
              || request.resource.data.channelId == null
              || request.resource.data.channelId == ''
              || request.resource.data.channelId == 'community-general')
            && request.resource.data.channelVisibility == "public"
          )
          || (request.resource.data.channelId is string
            && hasJoinedChannel(request.resource.data.channelId)
            && request.resource.data.channelVisibility
              == get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.get("visibility", "public"))
        );
      allow update: if isSignedIn() && (
        (
          ownsExistingResource("authorId")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "title",
            "content",
            "category",
            "debateType",
            "updatedAt"
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reported", "updatedAt"])
          && request.resource.data.reported == true
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["shareCount", "updatedAt"])
          && incrementsByOne("shareCount")
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["replyCount", "updatedAt"])
          && incrementsByOne("replyCount")
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "likeCount",
            "dislikeCount",
            "favoriteCount",
            "updatedAt"
          ])
          && stepsAtMostOne("likeCount")
          && stepsAtMostOne("dislikeCount")
          && stepsAtMostOne("favoriteCount")
        )
      );
      allow delete: if ownsExistingResource("authorId");
    }

    function postData(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data;
    }

    match /postComments/{commentId} {
      allow read: if canReadChannelContent();
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.channelVisibility == postData(request.resource.data.postId).channelVisibility
        && request.resource.data.get("channelId", "") == postData(request.resource.data.postId).get("channelId", "");
      // Vote and reply tallies are maintained by any signed-in voter; the
      // per-user vote itself lives in postCommentReactions.
      allow update: if isSignedIn()
        && (isCommentCounterUpdate() || isOwnCommentEdit());
      allow delete: if ownsExistingResource("authorId");
    }

    match /postReactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isOwnReactionWrite(reactionId, "postId");
    }

    match /postCommentReactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isOwnReactionWrite(reactionId, "commentId");
    }

    // Written only by the Tabroom sync Cloud Function.
    match /userStats/{statsId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Same access as the speech itself. Lists must filter on one speechId.
    function canReadSpeechById(speechId) {
      let speech = get(/databases/$(database)/documents/speeches/$(speechId)).data;
      return isSignedIn()
        && (
          speech.visibility == "public"
          || speech.creatorId == request.auth.uid
          || exists(/databases/$(database)/documents/speechShares/$(speechId)/recipients/$(request.auth.uid))
        );
    }

    match /speechComments/{commentId} {
      allow read: if canReadSpeechById(resource.data.speechId);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      // Vote tallies are maintained by any signed-in voter; the per-user vote
      // itself lives in speechCommentReactions.
      allow update: if isSignedIn()
        && (isCommentCounterUpdate() || isOwnCommentEdit());
      allow delete: if ownsExistingResource("authorId");
    }

    match /speechCommentReactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isOwnReactionWrite(reactionId, "commentId");
    }

    match /speeches/{speechId} {
      allow read: if canReadSpeech(speechId);
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && hasValidSpeechVisibility()
        && !request.resource.data.keys().hasAny(["aiSummary", "summary"]);
      allow update: if ownsExistingResource("creatorId")
        && request.resource.data.creatorId == resource.data.creatorId
        && hasValidSpeechVisibility()
        && keepsServerManagedSpeechSummary();
      allow delete: if ownsExistingResource("creatorId");
    }

    match /speechSaves/{saveId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsExistingResource("userId");
    }

    // A private speech remains unlisted, but its creator can grant selected
    // message recipients access to the detail page by document ID.
    match /speechShares/{speechId}/recipients/{recipientId} {
      allow get: if isOwner(recipientId)
        || (isSignedIn()
          && get(/databases/$(database)/documents/speeches/$(speechId)).data.creatorId == request.auth.uid);
      allow list: if false;
      allow create, update: if isSignedIn()
        && get(/databases/$(database)/documents/speeches/$(speechId)).data.creatorId == request.auth.uid
        && request.resource.data.recipientId == recipientId
        && request.resource.data.grantedBy == request.auth.uid;
      allow delete: if isSignedIn()
        && get(/databases/$(database)/documents/speeches/$(speechId)).data.creatorId == request.auth.uid;
    }

    // Each member can file one report per public speech. Reports are private
    // to the reporter; moderators read them through Admin SDK access.
    match /speechReports/{userId}/reports/{speechId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && request.resource.data.reporterId == userId
        && request.resource.data.speechId == speechId
        && request.resource.data.reason in [
          "Harassment", "Inappropriate content", "Spam", "Copyright", "Other"
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == "open"
        && get(/databases/$(database)/documents/speeches/$(speechId)).data.visibility == "public"
        && get(/databases/$(database)/documents/speeches/$(speechId)).data.creatorId != userId;
      allow update, delete: if false;
    }

    function debateData(debateId) {
      return get(/databases/$(database)/documents/debates/$(debateId)).data;
    }

    function isDebateParticipant(debateId) {
      return isSignedIn()
        && request.auth.uid in debateData(debateId).participantIds;
    }

    // Comments are allowed only when the debate opted in, and — while the debate
    // is still running — only for spectators (non-participants). Once completed,
    // anyone signed in may comment.
    function debateCommentsAllowed(debateId) {
      let debate = debateData(debateId);
      return debate.commentsEnabled == true
        && (
          debate.status == "Completed"
          || !(request.auth.uid in debate.participantIds)
        );
    }

    function keepsServerManagedDebateFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "aiSummary",
        "summary",
        "summaryStatus",
        "summaryModel",
        "summaryPromptVersion",
        "summaryTranscriptRefs",
        "summaryResponseId",
        "summaryGeneratedAt",
        "summaryPendingTurnIds",
        "summaryError",
        "summaryProcessingStartedAt",
        "summaryProcessingEventId",
        "communityVoteCounts",
        "spectators",
        "liveSpectators",
        "viewCount"
      ]);
    }

    function createsNoServerManagedDebateFields() {
      return !request.resource.data.keys().hasAny([
        "aiSummary",
        "summary",
        "summaryStatus",
        "summaryModel",
        "summaryPromptVersion",
        "summaryTranscriptRefs",
        "summaryResponseId",
        "summaryGeneratedAt",
        "summaryPendingTurnIds",
        "summaryError",
        "summaryProcessingStartedAt",
        "summaryProcessingEventId",
        "communityVoteCounts",
        "spectators",
        "liveSpectators",
        "viewCount"
      ]);
    }

    function isNewDebateAtStart() {
      return createsNoServerManagedDebateFields()
        && request.resource.data.turns == []
        && request.resource.data.get("likeCount", 0) == 0
        && request.resource.data.get("dislikeCount", 0) == 0
        && request.resource.data.get("favoriteCount", 0) == 0
        && request.resource.data.get("shareCount", 0) == 0
        && request.resource.data.get("commentCount", 0) == 0;
    }

    function isNewPrivateDebate() {
      return request.resource.data.visibility == "private"
        && request.resource.data.status == "Awaiting Opponent"
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participantIds == [request.auth.uid];
    }

    // Accepting an open challenge creates a public debate between its creator
    // and the signed-in user, and only while the challenge is still open.
    function isDebateFromOpenChallenge() {
      let challenge = get(/databases/$(database)/documents/matchRequests/$(request.resource.data.matchRequestId)).data;
      return request.resource.data.visibility == "public"
        && request.resource.data.status == "Active"
        && challenge.status == "Open"
        && challenge.creatorId != request.auth.uid
        && request.resource.data.creatorId == challenge.creatorId
        && request.resource.data.participantIds == [challenge.creatorId, request.auth.uid];
    }

    // Appends the signed-in user's own turn and leaves earlier turns untouched.
    function isOwnTurnSubmission() {
      let previousTurns = resource.data.get("turns", []);
      let turns = request.resource.data.turns;
      return request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "turns",
          "currentRound",
          "currentTurnUserId",
          "status",
          "updatedAt"
        ])
        && resource.data.status == "Active"
        && resource.data.get("currentTurnUserId", null) in [request.auth.uid, null]
        && turns.size() == previousTurns.size() + 1
        // A list can't be sliced to length 0, so a first turn skips this check.
        && (previousTurns.size() == 0 || turns[0:previousTurns.size()] == previousTurns)
        && turns[previousTurns.size()].authorId == request.auth.uid
        && (request.resource.data.currentTurnUserId == null
          || request.resource.data.currentTurnUserId in resource.data.participantIds)
        && (request.resource.data.status == "Active"
          || (request.resource.data.status == "Completed"
            && turns.size() >= resource.data.totalRounds));
    }

    // Repairs debates that have every turn but were never marked complete.
    function isCompletionRepair() {
      return request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "currentRound",
          "currentTurnUserId",
          "status",
          "updatedAt"
        ])
        && request.resource.data.status == "Completed"
        && request.resource.data.currentTurnUserId == null
        && resource.data.get("turns", []).size() >= resource.data.totalRounds;
    }

    function isDebateTallyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (resource.data.visibility == "public"
          || request.auth.uid in resource.data.participantIds)
        && (
          (
            changed.hasOnly(["likeCount", "dislikeCount", "favoriteCount", "updatedAt"])
            && stepsAtMostOne("likeCount")
            && stepsAtMostOne("dislikeCount")
            && stepsAtMostOne("favoriteCount")
          )
          || (changed.hasOnly(["commentCount", "updatedAt"]) && incrementsByOne("commentCount"))
          || (changed.hasOnly(["shareCount", "updatedAt"]) && incrementsByOne("shareCount"))
        );
    }

    match /debates/{debateId} {
      // Lists must filter on visibility == "public" or on participantIds
      // containing the user. Joining by invite code goes through a callable,
      // because the joiner can't read a private debate until they are in it.
      allow read: if isSignedIn()
        && (resource.data.visibility == "public"
          || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn()
        && isNewDebateAtStart()
        && (isNewPrivateDebate() || isDebateFromOpenChallenge());
      allow update: if isSignedIn()
        && (isOwnTurnSubmission() || isCompletionRepair() || isDebateTallyUpdate());
    }

    // Raw debate transcripts are written by Cloud Functions and are not exposed
    // to clients. The generated, student-facing summary is stored on the debate.
    match /debateTranscripts/{transcriptId} {
      allow read, write: if false;
    }

    // Same for speech-library transcripts; the student-facing summary lives on
    // the speech document.
    match /speechTranscripts/{transcriptId} {
      allow read, write: if false;
    }

    match /matchRequests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == "Open";
      allow update: if isSignedIn()
        && (
          // The creator can change the challenge's status.
          (
            ownsExistingResource("creatorId")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"])
          )
          // An accepter closes it in the same write that creates the debate.
          || (
            resource.data.status == "Open"
            && request.resource.data.status == "Matched"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "matchedDebateId", "updatedAt"])
            && getAfter(/databases/$(database)/documents/debates/$(request.resource.data.matchedDebateId)).data.matchRequestId == requestId
            && request.auth.uid in getAfter(/databases/$(database)/documents/debates/$(request.resource.data.matchedDebateId)).data.participantIds
          )
        );
    }

    // Messages carry a copy of participantIds so a list can be checked without
    // one lookup per debate. The join callable adds new participants to them.
    match /debateMessages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Only debate participants may post to the participant chat.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && isDebateParticipant(request.resource.data.debateId)
        && request.resource.data.participantIds == debateData(request.resource.data.debateId).participantIds;
    }

    // Comments carry a copy of the debate's audience for the same reason.
    match /debateComments/{commentId} {
      allow read: if isSignedIn()
        && (resource.data.debateVisibility == "public"
          || request.auth.uid in resource.data.participantIds);
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && debateCommentsAllowed(request.resource.data.debateId)
        && request.resource.data.debateVisibility == debateData(request.resource.data.debateId).visibility
        && request.resource.data.participantIds == debateData(request.resource.data.debateId).participantIds;
    }

    match /debateReactions/{reactionId} {
      // `resource` is null when the like flow checks for an earlier reaction.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isOwnReactionWrite(reactionId, "debateId");
    }

    match /debateWinnerVotes/{voteId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      // The callable validates spectator status, then atomically updates the
      // private vote, anonymous public feedback, and debate-wide tallies.
      allow create, update, delete: if false;
    }

    match /debateWinnerVoteFeedback/{feedbackId} {
      allow read: if isSignedIn()
        && debateData(resource.data.debateId).status == "Completed"
        && debateData(resource.data.debateId).visibility == "public";
      allow create, update, delete: if false;
    }

    match /debateViewSessions/{viewSessionId} {
      allow read, write: if false;
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.category in ["Case Building", "Rebuttal", "Research", "Delivery"]
        && request.resource.data.description is string
        && request.resource.data.curatedBy is string
        && request.resource.data.level in ["Starter", "Growth", "Advanced"];
      allow update: if ownsExistingResource("creatorId")
        && request.resource.data.creatorId == request.auth.uid;
    }

    // `resource` is null when a client reads a document that does not exist
    // yet. Without the null guard the rule errors out and the read is denied,
    // so "is this saved?" style lookups failed before anything was ever saved.
    match /resourceNotes/{noteId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if ownsExistingResource("userId");
    }

    match /resourceSaves/{saveId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if ownsExistingResource("userId");
    }

    // Personal folders store links and short display summaries for items in a
    // user's speech, async debate, and resource libraries. Public folders are
    // readable to signed-in members and their private engagement records stay
    // scoped to each member.
    function folderDocument(folderId) {
      return get(/databases/$(database)/documents/folders/$(folderId));
    }

    function ownsFolder(folderId) {
      return isSignedIn()
        && folderDocument(folderId).data.userId == request.auth.uid;
    }

    function isPublicFolder(folderId) {
      return isSignedIn()
        && folderDocument(folderId).data.visibility == "public";
    }

    // Owners and collaborators who accepted an invite can manage a folder's
    // content. Only the owner can rename it, change visibility, or delete it.
    function isFolderMember(folderId) {
      let folder = folderDocument(folderId);
      return isSignedIn()
        && (folder.data.userId == request.auth.uid
          || request.auth.uid in folder.data.get("collaboratorIds", []));
    }

    function folderInviteId(folderId, inviteeId) {
      return folderId + "__" + inviteeId;
    }

    function folderBoardLayoutChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["boardOrder", "boardSize", "boardWidth", "boardHeight"]);
    }

    function stepsByOne(field, previous) {
      return request.resource.data[field] is int
        && request.resource.data[field] >= 0
        && (request.resource.data[field] == previous + 1 || request.resource.data[field] == previous - 1);
    }

    function commentReactionCountsAreValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(["likeCount", "dislikeCount"])
        && (!("likeCount" in changed) || stepsByOne("likeCount", resource.data.get("likeCount", 0)))
        && (!("dislikeCount" in changed) || stepsByOne("dislikeCount", resource.data.get("dislikeCount", 0)));
    }

    function countChangesAreValid() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldLikes = ("likeCount" in resource.data) ? resource.data.likeCount : 0;
      let oldDislikes = ("dislikeCount" in resource.data) ? resource.data.dislikeCount : 0;
      let oldSaves = ("saveCount" in resource.data) ? resource.data.saveCount : 0;
      let oldShares = ("shareCount" in resource.data) ? resource.data.shareCount : 0;
      let oldComments = ("commentCount" in resource.data) ? resource.data.commentCount : 0;
      return changed.hasOnly(["likeCount", "dislikeCount", "saveCount", "shareCount", "commentCount", "updatedAt"])
        && (!("likeCount" in changed) || (request.resource.data.likeCount is int && request.resource.data.likeCount >= 0 && (request.resource.data.likeCount == oldLikes + 1 || request.resource.data.likeCount == oldLikes - 1)))
        && (!("dislikeCount" in changed) || (request.resource.data.dislikeCount is int && request.resource.data.dislikeCount >= 0 && (request.resource.data.dislikeCount == oldDislikes + 1 || request.resource.data.dislikeCount == oldDislikes - 1)))
        && (!("saveCount" in changed) || (request.resource.data.saveCount is int && request.resource.data.saveCount >= 0 && (request.resource.data.saveCount == oldSaves + 1 || request.resource.data.saveCount == oldSaves - 1)))
        && (!("shareCount" in changed) || (request.resource.data.shareCount is int && request.resource.data.shareCount == oldShares + 1))
        && (!("commentCount" in changed) || (request.resource.data.commentCount is int && request.resource.data.commentCount >= 0 && (request.resource.data.commentCount == oldComments + 1 || request.resource.data.commentCount == oldComments - 1)))
        && request.resource.data.updatedAt is string;
    }

    match /folders/{folderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || resource.data.visibility == "public"
          || request.auth.uid in resource.data.get("collaboratorIds", []));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.visibility in ["public", "private"]
        && (!("parentFolderId" in request.resource.data)
          || (request.resource.data.parentFolderId is string
            && ownsFolder(request.resource.data.parentFolderId)
            && folderDocument(request.resource.data.parentFolderId).data.visibility == request.resource.data.visibility))
        && request.resource.data.likeCount == 0
        && request.resource.data.dislikeCount == 0
        && request.resource.data.saveCount == 0
        && request.resource.data.shareCount == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.itemCount == 0
        && request.resource.data.fileCount == 0
        && !("collaboratorIds" in request.resource.data);
      // Owners edit details and may remove collaborators, but collaborators
      // are only ever added by accepting an invite.
      allow update: if (ownsExistingResource("userId")
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.visibility in ["public", "private"]
          && (!("parentFolderId" in request.resource.data)
            || (request.resource.data.parentFolderId is string
              && request.resource.data.parentFolderId != folderId
              && ownsFolder(request.resource.data.parentFolderId)
              && folderDocument(request.resource.data.parentFolderId).data.get("visibility", "private") == request.resource.data.visibility))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "description", "visibility", "parentFolderId", "tournamentId", "tournamentName", "updatedAt", "itemCount", "fileCount", "collaboratorIds"])
          && request.resource.data.get("collaboratorIds", []).toSet()
            .difference(resource.data.get("collaboratorIds", []).toSet()).size() == 0)
        || (request.auth.uid in resource.data.get("collaboratorIds", [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["itemCount", "fileCount", "updatedAt"]))
        || (isSignedIn()
          && exists(/databases/$(database)/documents/folderInvites/$(folderInviteId(folderId, request.auth.uid)))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["collaboratorIds", "updatedAt"])
          && request.resource.data.collaboratorIds.toSet()
            == resource.data.get("collaboratorIds", []).toSet().union([request.auth.uid].toSet()))
        || (isSignedIn()
          && request.auth.uid in resource.data.get("collaboratorIds", [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["collaboratorIds", "updatedAt"])
          && request.resource.data.collaboratorIds.toSet()
            == resource.data.collaboratorIds.toSet().difference([request.auth.uid].toSet()))
        || ((isFolderMember(folderId)
          || ("parentFolderId" in resource.data && isFolderMember(resource.data.parentFolderId)))
          && folderBoardLayoutChange())
        || (isPublicFolder(folderId) && countChangesAreValid());
      allow delete: if ownsExistingResource("userId");
    }

    match /folderItems/{folderItemId} {
      // Transactions check deterministic child IDs before creating them. Let
      // signed-in users read a missing document (it contains no private data),
      // while keeping existing items owner/public-folder scoped.
      allow get: if isSignedIn() && (resource == null
        || resource.data.userId == request.auth.uid
        || isFolderMember(resource.data.folderId)
        || (resource.data.visibility == "public" && isPublicFolder(resource.data.folderId)));
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || isFolderMember(resource.data.folderId)
          || (resource.data.visibility == "public" && isPublicFolder(resource.data.folderId)));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.folderId is string
        && request.resource.data.itemType in ["speech", "debate", "resource"]
        && request.resource.data.itemId is string
        && request.resource.data.itemTitle is string
        && request.resource.data.sourceVisibility in ["public", "private"]
        && isFolderMember(request.resource.data.folderId)
        && request.resource.data.visibility == folderDocument(request.resource.data.folderId).data.visibility
        && (request.resource.data.visibility == "private" || request.resource.data.sourceVisibility == "public");
      // Re-adding an item rewrites it as the member who added it; any member
      // can arrange the board; the owner syncs visibility across all items.
      allow update: if (isSignedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.folderId == resource.data.folderId
          && isFolderMember(request.resource.data.folderId)
          && request.resource.data.sourceVisibility in ["public", "private"]
          && request.resource.data.visibility == folderDocument(request.resource.data.folderId).data.visibility
          && (request.resource.data.visibility == "private" || request.resource.data.sourceVisibility == "public"))
        || (isFolderMember(resource.data.folderId) && folderBoardLayoutChange())
        || (ownsFolder(resource.data.folderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility", "sourceVisibility"])
          && request.resource.data.visibility == folderDocument(resource.data.folderId).data.visibility);
      allow delete: if ownsExistingResource("userId") || isFolderMember(resource.data.folderId);
    }

    match /folderInvites/{inviteId} {
      allow read: if isSignedIn()
        && (resource.data.inviteeId == request.auth.uid
          || resource.data.inviterId == request.auth.uid
          || ownsFolder(resource.data.folderId));
      allow create: if isSignedIn()
        && inviteId == folderInviteId(request.resource.data.folderId, request.resource.data.inviteeId)
        && request.resource.data.inviterId == request.auth.uid
        && ownsFolder(request.resource.data.folderId)
        && request.resource.data.inviteeId is string
        && request.resource.data.inviteeId != request.auth.uid
        && !(request.resource.data.inviteeId in folderDocument(request.resource.data.folderId).data.get("collaboratorIds", []))
        && request.resource.data.folderName is string
        && request.resource.data.inviterName is string
        && request.resource.data.inviteeName is string;
      allow delete: if isSignedIn()
        && (resource.data.inviteeId == request.auth.uid
          || resource.data.inviterId == request.auth.uid
          || ownsFolder(resource.data.folderId));
    }

    match /folderReactions/{reactionId} {
      allow get: if isSignedIn() && (resource == null
        || resource.data.userId == request.auth.uid
        || ownsFolder(resource.data.folderId)
        || isPublicFolder(resource.data.folderId));
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || ownsFolder(resource.data.folderId) || isPublicFolder(resource.data.folderId));
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isPublicFolder(request.resource.data.folderId)
        && request.resource.data.like is bool
        && request.resource.data.dislike is bool;
      allow delete: if ownsExistingResource("userId") || ownsFolder(resource.data.folderId);
    }

    match /folderSaves/{saveId} {
      allow get: if isSignedIn() && (resource == null
        || resource.data.userId == request.auth.uid
        || ownsFolder(resource.data.folderId)
        || isPublicFolder(resource.data.folderId));
      allow list: if isSignedIn()
        && (resource.data.userId == request.auth.uid || ownsFolder(resource.data.folderId) || isPublicFolder(resource.data.folderId));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isPublicFolder(request.resource.data.folderId);
      allow delete: if ownsExistingResource("userId") || ownsFolder(resource.data.folderId);
    }

    match /folderComments/{commentId} {
      allow read: if isSignedIn()
        && (ownsFolder(resource.data.folderId)
          || (resource.data.visibility == "public" && isPublicFolder(resource.data.folderId)));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.visibility == "public"
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && isPublicFolder(request.resource.data.folderId)
        && request.resource.data.get("likeCount", 0) == 0
        && request.resource.data.get("dislikeCount", 0) == 0;
      // Reactions adjust the counters; authors may edit only their own text.
      allow update: if (isPublicFolder(resource.data.folderId) && commentReactionCountsAreValid())
        || (ownsExistingResource("userId")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["content", "editedAt"])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.editedAt is string);
      allow delete: if ownsExistingResource("userId") || ownsFolder(resource.data.folderId);
    }

    match /folderCommentReactions/{reactionId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn()
        && reactionId == request.resource.data.commentId + "-" + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.commentId is string
        && isPublicFolder(request.resource.data.folderId)
        && request.resource.data.like is bool
        && request.resource.data.dislike is bool;
      allow delete: if ownsExistingResource("userId");
    }

    match /folderFiles/{fileId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid
          || isFolderMember(resource.data.folderId)
          || (resource.data.visibility == "public" && isPublicFolder(resource.data.folderId)));
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isFolderMember(request.resource.data.folderId)
        && request.resource.data.visibility == folderDocument(request.resource.data.folderId).data.visibility
        && request.resource.data.storagePath is string;
      allow update: if (isFolderMember(resource.data.folderId) && folderBoardLayoutChange())
        || (ownsFolder(resource.data.folderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["visibility"])
          && request.resource.data.visibility == folderDocument(resource.data.folderId).data.visibility);
      allow delete: if ownsExistingResource("userId") || isFolderMember(resource.data.folderId);
    }

    match /channels/{channelId} {
      allow read: if true;
      // Channels are public documents, so invite codes live in channelInvites.
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && !("inviteCode" in request.resource.data);
      allow update, delete: if ownsExistingResource("creatorId");
    }

    match /debateChatReads/{readId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create, update: if isOwnReactionWrite(readId, "debateId");
    }

    function chatData(threadId) {
      return get(/databases/$(database)/documents/chatThreads/$(threadId)).data;
    }

    function isChatParticipant(threadId) {
      return isSignedIn()
        && request.auth.uid in chatData(threadId).participantIds;
    }

    function canSendToThread(threadId) {
      let thread = chatData(threadId);
      let others = thread.participantIds.removeAll([request.auth.uid]);
      return thread.type != "direct"
        || (others.size() == 1 && !isBlockedBetween(request.auth.uid, others[0]));
    }

    function isValidDirectThreadCreate() {
      let recipients = request.resource.data.participantIds.removeAll([request.auth.uid]);
      return request.resource.data.type == "direct"
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.memberCount == 2
        && request.resource.data.participantIds[0] != request.resource.data.participantIds[1]
        && recipients.size() == 1
        && recipientAllowsMessage(recipients[0], request.auth.uid);
    }

    function isValidGroupThreadCreate() {
      return request.resource.data.type == "group"
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.memberCount == 1;
    }

    function isAddingAllowedGroupMember() {
      let added = request.resource.data.participantIds.removeAll(resource.data.participantIds);
      return resource.data.type == "group"
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "participantIds",
          "memberCount",
          "updatedAt"
        ])
        && added.size() == 1
        && request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1
        && request.resource.data.memberCount == resource.data.memberCount + 1
        && recipientAllowsMessage(added[0], request.auth.uid);
    }

    function isChatMetadataUpdate() {
      return request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastMessageText",
          "lastMessageAt",
          "lastMessageSenderId",
          "updatedAt"
        ])
        && request.resource.data.lastMessageSenderId == request.auth.uid;
    }

    match /chatThreads/{threadId} {
      allow read: if isSignedIn()
        && resource != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && (isValidDirectThreadCreate() || isValidGroupThreadCreate());
      allow update: if isSignedIn()
        && (isAddingAllowedGroupMember() || isChatMetadataUpdate());
      allow delete: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.participantIds == [request.auth.uid];
    }

    match /chatMessages/{messageId} {
      // Reads are authorized from the message's own denormalized
      // participantIds. Resolving the parent thread with get() instead costs
      // one document access call per returned message, and a query is only
      // allowed 10 in total, so a conversation stopped loading once it had a
      // handful of messages. The get() fallback only runs for messages written
      // before participantIds existed.
      allow read: if isSignedIn()
        && (
          (
            "participantIds" in resource.data
            && request.auth.uid in resource.data.participantIds
          )
          || (
            !("participantIds" in resource.data)
            && isChatParticipant(resource.data.threadId)
          )
        );
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && !("attachment" in request.resource.data)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && (!("replyTo" in request.resource.data)
          || (request.resource.data.replyTo is map
            && request.resource.data.replyTo.messageId is string
            && request.resource.data.replyTo.authorId in request.resource.data.participantIds
            && request.resource.data.replyTo.authorName is string
            && request.resource.data.replyTo.content is string
            && request.resource.data.replyTo.content.size() <= 240))
        && request.resource.data.participantIds
          == chatData(request.resource.data.threadId).participantIds
        && isChatParticipant(request.resource.data.threadId)
        && canSendToThread(request.resource.data.threadId);
      allow update: if ownsExistingResource("authorId")
        && !("deletedAt" in resource.data)
        && (
          (
            !("attachment" in resource.data)
            && !("sharedPreview" in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["content", "editedAt"])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 4000
            && request.resource.data.editedAt is string
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["content", "deletedAt", "editedAt", "sharedPreview", "attachment"])
            && request.resource.data.content == "message deleted"
            && request.resource.data.deletedAt is string
            && !("attachment" in request.resource.data)
            && !("sharedPreview" in request.resource.data)
          )
        );
    }

    match /chatMessageReactions/{reactionId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.messageId is string
        && reactionId == request.resource.data.messageId + "--" + request.auth.uid
        && request.resource.data.threadId is string
        && request.resource.data.participantIds == chatData(request.resource.data.threadId).participantIds
        && isChatParticipant(request.resource.data.threadId)
        && request.resource.data.emoji in ["👍", "❤️", "😂", "😮", "🙏"];
      allow delete: if ownsExistingResource("userId")
        && request.auth.uid in resource.data.participantIds;
    }

    match /chatThreadPins/{pinId} {
      allow read: if ownsExistingResource("userId");
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.threadId is string
        && pinId == request.auth.uid + "--" + request.resource.data.threadId
        && isChatParticipant(request.resource.data.threadId);
      allow delete: if ownsExistingResource("userId");
    }

    match /channelMemberships/{membershipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.channelId is string
        && membershipId == request.resource.data.channelId + "-" + request.auth.uid
        && !("inviteCode" in request.resource.data)
        && exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
        // Private channels are joined through the joinChannelByInviteCode
        // callable; memberships are readable, so a code can't be stored on them.
        && (
          get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.creatorId == request.auth.uid
          || !('visibility' in get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data)
          || get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.visibility == 'public'
        );
      allow update: if ownsExistingResource("userId")
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt"]);
      allow delete: if ownsExistingResource("userId");
    }

    match /channelInvites/{inviteCode} {
      allow get: if ownsExistingResource("createdBy");
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.channelId is string
        && exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
        && get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.creatorId == request.auth.uid
        && get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.visibility == "private";
      allow update: if false;
      allow delete: if ownsExistingResource("createdBy");
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
    }
  }
}
